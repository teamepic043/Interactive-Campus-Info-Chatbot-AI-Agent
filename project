        "# --- LLM Initialization ---\n",
        "# Model for structured JSON link extraction\n",
        "links_llm = ChatGoogleGenerativeAI(\n",
        "    model=\"gemini-2.5-flash-lite\",\n",
        "    temperature=0\n",
        ")\n",
        "\n",
        "# Model for brochure generation\n",
