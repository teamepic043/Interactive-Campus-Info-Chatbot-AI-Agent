      "source": [
        "# --- Web Scraping Utilities ---\n",
        "\n",
        "HEADERS = {\n",
        "    \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) \"\n",
        "                  \"AppleWebKit/537.36 (KHTML, like Gecko) \"\n",
        "                  \"Chrome/117.0.0.0 Safari/537.36\"\n",
        "}\n",
        "\n",
        "def fetch_website_contents(url: str) -> str:\n",
        "    \"\"\"Fetch and return the visible text content of a webpage.\"\"\"\n",
        "    response = requests.get(url, headers=HEADERS)\n",
        "    response.raise_for_status()\n",
        "    soup = BeautifulSoup(response.text, \"html.parser\")\n",
        "    return soup.get_text(separator=\" \", strip=True)\n",
        "\n",
        "def fetch_website_links(url: str) -> list[str]:\n",
        "    \"\"\"Fetch all href links from a webpage.\"\"\"\n",
        "    response = requests.get(url, headers=HEADERS)\n",
        "    response.raise_for_status()\n",
        "    soup = BeautifulSoup(response.content, \"html.parser\")\n",
        "    links = [a.get(\"href\") for a in soup.find_all(\"a\")]\n",
        "    return [link for link in links if link]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 20,
      "metadata": {
        "id": "IXSgNa9wu_UH"
      },
      "outputs": [],
      "source": [
        "# --- Pydantic Schema for Structured Output ---\n",
        "\n",
        "class LinkEntry(BaseModel):\n",
        "    type: str = Field(description=\"Type of the page, e.g. 'about page', 'careers page'\")\n",
        "    url: str = Field(description=\"Full https URL of the page\")\n",
        "\n",
        "class RelevantLinks(BaseModel):\n",
        "    links: List[LinkEntry] = Field(description=\"List of relevant college links\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 21,
      "metadata": {
        "id": "p9gZfslVu_UI"
      },
      "outputs": [],
      "source": [
        "# --- Chain 1: Relevant Link Extractor ---\n",
        "\n",
        "link_parser = PydanticOutputParser(pydantic_object=RelevantLinks)\n",
        "\n",
        "links_prompt = ChatPromptTemplate.from_messages([\n",
        "    SystemMessagePromptTemplate.from_template(\n",
        "        \"\"\"You are going to fetch relevant links from a website such as About Us, Social Media, and Careers pages.\n",
        "You must respond ONLY with valid JSON matching this schema:\n",
        "{format_instructions}\"\"\"\n",
        "    ),\n",
        "    HumanMessagePromptTemplate.from_template(\n",
        "        \"\"\"Here is the list of links on the website {url}.\n",
        "Please decide which of these are relevant for a college or University brochure.\n",
        "Respond with the full https URL in JSON format.\n",
        "Do NOT include Terms of Service, Privacy, or email links.\n",
        "\n",
        "Links (some might be relative):\n",
        "{links}\"\"\"\n",
        "    )\n",
        "])\n",
        "\n",
        "links_chain = links_prompt | links_llm | link_parser\n",
        "\n",
        "def extract_relevant_links(url: str) -> list[dict]:\n",
        "    \"\"\"Use LangChain chain to extract relevant links from a URL.\"\"\"\n",
        "    raw_links = fetch_website_links(url)\n",
        "    links_str = \"\\n\".join(raw_links)\n",
        "    result = links_chain.invoke({\n",
        "        \"url\": url,\n",
        "        \"links\": links_str,\n",
        "        \"format_instructions\": link_parser.get_format_instructions()\n",
        "    })\n",
        "    return [link.dict() for link in result.links]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 22,
      "metadata": {
        "id": "SGFw59icu_UI"
      },
      "outputs": [],
      "source": [
        "# --- Content Aggregator ---\n",
        "\n",
        "def fetch_page_and_all_relevant_links(url: str) -> str:\n",
        "    \"\"\"Fetch landing page content + all relevant linked pages.\"\"\"\n",
        "    contents = fetch_website_contents(url)\n",
        "    relevant_links = extract_relevant_links(url)\n",
        "\n",
        "    result = f\"## Landing Page:\\n\\n{contents}\\n\\n## Relevant Links:\\n\"\n",
        "\n",
        "    for link in relevant_links:\n",
        "        try:\n",
        "            result += f\"\\n\\n### {link['type']}\\n\"\n",
        "            result += fetch_website_contents(link[\"url\"])\n",
        "        except requests.exceptions.HTTPError as e:\n",
        "            result += f\"\\n\\n### {link['type']} (Error: {e})\\n\"\n",
        "            result += \"Could not fetch content for this link.\"\n",
        "\n",
        "    return result"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 23,
      "metadata": {
        "id": "Dbc2hJuLu_UI"
      },
      "outputs": [],
      "source": [
        "# --- Chain 2: Brochure Generator ---\n",
        "\n",
        "brochure_prompt = ChatPromptTemplate.from_messages([\n",
        "    SystemMessagePromptTemplate.from_template(\n",
        "      \"\"\"You are an informative assistant that creates engaging brochures for Colleges and Universities\n",
        "        to help prospective students decide whether to apply. Keep it positive, concise, and structured in markdown.\"\"\"\n",
        "    ),\n",
        "    HumanMessagePromptTemplate.from_template(\n",
        "        \"\"\"You are looking at a company called: {company_name}\n",
        "Here are the contents of its landing page and other relevant pages;\n",
        "use this information to build a short brochure of the college in markdown without code blocks.\n",
        "\n",
        "{page_contents}\"\"\"\n",
        "    )\n",
        "])\n",
        "\n",
        "brochure_chain = brochure_prompt | brochure_llm | StrOutputParser()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 24,
      "metadata": {
        "id": "Xo1XHu0cu_UI"
      },
      "outputs": [],
      "source": [
        "# --- Full Pipeline ---\n",
        "\n",
        "def create_brochure(company_name: str, url: str) -> str:\n",
        "    \"\"\"End-to-end pipeline: scrape website → extract links → generate brochure.\"\"\"\n",
        "    print(f\"Fetching content for {company_name} at {url}...\")\n",
        "    page_contents = fetch_page_and_all_relevant_links(url)\n",
        "    page_contents = page_contents[:5_000]  # Truncate to avoid token limits\n",
        "\n",
        "    print(\"Generating brochure...\")\n",
        "    brochure = brochure_chain.invoke({\n",
        "        \"company_name\": company_name,\n",
        "        \"page_contents\": page_contents\n",
        "    })\n",
        "    return brochure"
      ]
    },
